<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 새 버전이 나왔는지 GitHub에 물어보고, 받은 APK로 스스로를 갈아끼우기 위함 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 이 권한이 있어야 두 번째 갱신부터 확인 화면 없이 스스로 갈아끼울 수 있다 -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- 블루투스 연결/해제 감지 (안드로이드 12+는 런타임 승인 필요) -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <!-- 와이파이 연결/해제 감지 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- "이 자리일 때만" 조건. 위치를 새로 잡지 않고 마지막으로 알려진 값만 읽는다 -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- 매크로가 배경에서 돌 때도 그 값을 읽어야 한다 -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- 매크로를 만들 때 설치된 앱 목록에서 고르기 위함 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!--
        WireGuard 터널을 켜고 끄는 브로드캐스트를 받는 리시버가 이 권한을 요구한다.
        WireGuard가 깔려 있어야 존재하는 권한이라, 그 매크로를 쓸 때만 묻는다.
    -->
    <uses-permission android:name="com.wireguard.android.permission.CONTROL_TUNNELS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartNoti">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 알림 리스너 = 매크로 엔진. 시스템이 붙잡고 있어서 별도 상주 서비스가 필요 없다 -->
        <service
            android:name=".MacroService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>


        <!-- 설치 결과를 돌려받는 곳. 시스템이 우리에게만 보내므로 밖에 열지 않는다 -->
        <receiver
            android:name=".InstallResultReceiver"
            android:exported="false" />

        <!-- 홈 화면에서 매크로를 손으로 돌리는 버튼 -->
        <receiver
            android:name=".MacroWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_macro_info" />
        </receiver>

        <!-- 위젯을 놓을 때 뜨는 고르기 화면. 런처가 부르므로 열어 둔다 -->
        <activity
            android:name=".WidgetConfigActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

    </application>

</manifest>
